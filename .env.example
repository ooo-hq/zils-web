# Public browser configuration. Leave blank to show the disconnected state.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ZILS_TRAINING_API_URL=
# Optional API base URL for key management; defaults to the training URL + /decision.
NEXT_PUBLIC_ZILS_API_URL=

# Server-only inference configuration. Never prefix the API key with NEXT_PUBLIC_.
# Shared model endpoint: https://training.zils.ai/decision/v1/systemone
ZILS_DECISION_API_URL=
ZILS_DECISION_API_KEY=
ZILS_DECISION_MODEL=zils-jevk5-v0.3-r1
ZILS_DECISION_LABEL="Zils shared · JevK5 4B"

# Server-only contact-form delivery. Use a sending key and a verified sender.
RESEND_API_KEY=
ZILS_CONTACT_FROM=
ZILS_CONTACT_TO=

# Early access: server only. Use the same Supabase project as the coordinator.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated, verified administrator emails. Never use NEXT_PUBLIC_.
ZILS_ADMIN_EMAILS=
# Exact website origin used for invitations; never derived from submitted headers.
ZILS_SITE_URL=https://zils.ai
# Verified Resend sender; falls back to ZILS_CONTACT_FROM.
ZILS_ACCESS_FROM=
