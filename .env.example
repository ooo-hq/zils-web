# Public browser configuration. Leave blank to show the disconnected state.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only after configuring Google's OAuth client in this Supabase project.
NEXT_PUBLIC_ZILS_GOOGLE_AUTH_ENABLED=
# Public first-party OAuth client UUID; see docs/cli-sign-in.md.
NEXT_PUBLIC_ZILS_CLI_OAUTH_CLIENT_ID=
NEXT_PUBLIC_ZILS_TRAINING_API_URL=
# Optional API base URL for key management and billing; defaults to training URL + /decision.
NEXT_PUBLIC_ZILS_API_URL=
# Set to "test" only for an isolated billing test environment. Leave unset for production.
# Production checkout also requires the API to report live mode; off mode never enables checkout.
NEXT_PUBLIC_ZILS_BILLING_PREVIEW=

# Server-only inference configuration. Never prefix the API key with NEXT_PUBLIC_.
# Shared model endpoint: https://training.zils.ai/decision/v1/systemone
ZILS_DECISION_API_URL=
ZILS_DECISION_API_KEY=
# Exact shared release ID registered on the inference server (a d3-mini release);
# the site builds in no default, so Run stays disabled until all three are set.
ZILS_DECISION_MODEL=
ZILS_DECISION_LABEL="Zils shared"

# Optional server-only setup assistant. Uses an OpenAI-compatible chat/completions
# endpoint with JSON-object output. Set all three to enable plain-language setup.
# The assistant drafts questions; it never substitutes for the Zils model.
ZILS_SETUP_API_URL=
ZILS_SETUP_API_KEY=
ZILS_SETUP_MODEL=

# Server-only contact-form delivery. Use a sending key and a verified sender.
RESEND_API_KEY=
ZILS_CONTACT_FROM=
ZILS_CONTACT_TO=

# Optional exact private Spaces bucket origin; authentication continues using Supabase.
NEXT_PUBLIC_ZILS_SPACES_URL=
